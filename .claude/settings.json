      "mcp__godot-ai__scene_save",
      "mcp__godot-ai__node_create",
      "mcp__godot-ai__node_manage",
      "mcp__godot-ai__node_set_property",
      "mcp__godot-ai__script_create",
      "mcp__godot-ai__script_patch",
      "mcp__godot-ai__script_attach",
      "mcp__godot-ai__script_manage",
      "mcp__godot-ai__resource_manage",
      "mcp__godot-ai__filesystem_manage",
      "mcp__godot-ai__autoload_manage",
      "mcp__godot-ai__input_map_manage",
      "mcp__godot-ai__signal_manage",
      "mcp__godot-ai__animation_create",
      "mcp__godot-ai__animation_manage",
      "mcp__godot-ai__audio_manage",
      "mcp__godot-ai__camera_manage",
      "mcp__godot-ai__csg_manage",
      "mcp__godot-ai__gridmap_manage",
      "mcp__godot-ai__material_manage",
